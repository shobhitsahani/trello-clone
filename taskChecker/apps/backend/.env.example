# ---------- TeamFlow API environment (copy to .env) ----------
# HTTP
PORT=4002
NODE_ENV=development

# ---------- Supabase (recommended for hosted) ----------
# Create a project at https://supabase.com, then in Project Settings → Database
# copy the pooler connection string (6543, pgbouncer=true) and paste as
# DATABASE_URL. Or keep the local Docker URL below.
#
# Supabase pooler (recommended, works with pgbouncer):
#   DATABASE_URL=postgres://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (5432, no pgbouncer):
#   DATABASE_URL=postgres://postgres:<password>@db.<project_ref>.supabase.co:5432/postgres
#
# Optional: also set the Supabase JS client env so the backend can use
# Supabase Auth / Storage via service_role where needed. Leave unset to keep
# using only the drizzle postgres client (local dev).
#   SUPABASE_URL=https://<project_ref>.supabase.co
#   SUPABASE_ANON_KEY=<anon key from API settings>
#   SUPABASE_SERVICE_ROLE_KEY=<service_role key — keep secret, server-only>
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — the app connects as NON-superuser `teamflow` so RLS is enforced
# (see docker/init.sql; superusers bypass row-level security).
# Provisioning (migrate/seed) instead uses the docker-compose superuser:
#   DATABASE_MIGRATE_URL=postgres://postgres:postgres@localhost:5432/teamflow bun run db:migrate
# For Supabase, migrations can run as the same pooler user:
#   DATABASE_MIGRATE_URL=postgres://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgres://teamflow:teamflow@localhost:5432/teamflow
# DATABASE_REPLICA_URL=postgres://teamflow:teamflow@localhost:5433/teamflow

# Redis (cache + rate-limit + pub/sub + BullMQ transport)
REDIS_URL=redis://localhost:6379

# Auth
# Generate with: openssl rand -base64 48  (or node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=dev-only-change-me-at-least-32-chars-with-randomness
ACCESS_TOKEN_TTL=15m

# Blob store (S3-compatible). UPLOAD_BACKEND=memory|s3
UPLOAD_BACKEND=memory
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=teamflow-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
PUBLIC_BASE_URL=http://localhost:4002
# Web app origin — invite links are built against this, not the API above.
FRONTEND_BASE_URL=http://localhost:4000

# Worker knobs
WORKER_WEBHOOK_RETRIES=10
# How often overdue open tasks are moved back to backlog (ms).
DEADLINE_SWEEP_MS=300000
WORKER_NOTIFICATION_PRIORITY=10
LOG_LEVEL=info