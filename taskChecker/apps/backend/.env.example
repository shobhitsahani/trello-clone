# ---------- TeamFlow API environment (copy to .env) ----------
# HTTP
PORT=8000
NODE_ENV=development

# Postgres — the app connects as NON-superuser `teamflow_app` so RLS is enforced.
# Provisioning (migrate/seed) instead uses the docker-compose superuser:
#   DATABASE_URL=postgres://teamflow:teamflow@localhost:5432/teamflow bun run db:migrate
DATABASE_URL=postgres://teamflow_app:teamflow_app@localhost:5432/teamflow
# DATABASE_REPLICA_URL=postgres://teamflow_app:teamflow_app@localhost:5433/teamflow

# Redis (cache + rate-limit + pub/sub + BullMQ transport)
REDIS_URL=redis://localhost:6379

# Auth
# Generate with: openssl rand -base64 48  (or node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=dev-only-change-me-at-least-32-chars-with-randomness
ACCESS_TOKEN_TTL=15m

# Blob store (S3-compatible). UPLOAD_BACKEND=memory|s3
UPLOAD_BACKEND=memory
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=teamflow-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
PUBLIC_BASE_URL=http://localhost:8000

# Worker knobs
WORKER_WEBHOOK_RETRIES=10
WORKER_NOTIFICATION_PRIORITY=10
LOG_LEVEL=info