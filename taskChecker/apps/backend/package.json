{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TeamFlow multi-tenant backend (Hono + Postgres + Redis + BullMQ)",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "TEAMFLOW_IT=1 bun test test/integration.test.ts",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/node-ws": "^1.1.0",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.116.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "ioredis": "^5.6.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/bun": "^1.2.0",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "prisma": "^6.4.1",
    "typescript": "7.0.2"
  }
}